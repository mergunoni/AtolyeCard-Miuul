# Copy to .env.local and fill in. .env.local is git-ignored.
# stock_alert POSTs here as multipart/form-data (n8n Form Trigger endpoint) —
# not JSON. Flat fields: customer_name, customer_email, product. See SKILL.md.
VITE_WEBHOOK_URL=https://example.com/form/atolyekart

# order_request POSTs here instead — a dedicated n8n workflow ("Sipariş Ver")
# that appends the order to a Google Sheet and sends an AI-generated thank-you
# email. Flat payload shape, no `event` field. See SKILL.md for the schema.
VITE_ORDER_WEBHOOK_URL=https://example.com/webhook/siparis-ver
